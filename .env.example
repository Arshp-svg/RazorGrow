# ==============================================================================
# RazorGrow - Autonomous AI Revenue Agent Environment Configuration
# Copy this file to .env and configure your production or sandbox credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Razorpay Payment Gateway Credentials (Required for Checkout & Webhooks)
# Obtain test keys at: https://dashboard.razorpay.com/#/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ------------------------------------------------------------------------------
# 2. LLM / AI Reasoning Provider
# Obtain Groq API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# Generate a secure 256-bit random hex: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Database & Infrastructure
# SQLite (default for local/demo) or PostgreSQL (e.g. postgresql://user:pass@host:5432/razorgrow)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./razorgrow.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Frontend Public Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere